# harness.conf — the ONE file you edit to point the gates at your project.
#
# Copy to `harness.conf` at your repo root and fill in. Every path is relative to
# the repo root. Anything left empty disables the gate that needs it, and the gate
# says so out loud rather than passing silently — a disabled check is never a pass.

# ── Stack ────────────────────────────────────────────────────────────────────
# WHICH LANGUAGE THIS PROJECT IS WRITTEN IN — and the single setting that turns the
# language-neutral gates into language-specific ones.
#
# No gate hardcodes a syntax. What a function declaration, a comment, a test file, a skip call, a
# log call, an error branch and generated code LOOK LIKE all come from a stack pack in
# scripts/stacks/. Precedence: pack defaults < anything you set in THIS file.
#
# Shipped: generic · go · typescript · python. `generic` is a loose union that works everywhere and
# proves little — fine for day one, wrong to stay on. Writing a pack for another language is ~20
# lines of config and no code (scripts/stacks/README.md).
#
# Proof, not assertion: `scripts/selftest.sh` builds its fixture FROM the pack, so a green run
# means the gates can see YOUR language's syntax. `--all-stacks` checks every shipped pack.
HARNESS_STACK="generic"

# Anything below this line overrides the pack. Leave a value out to take the pack's.

# ── Docs ──────────────────────────────────────────────────────────────────────
# Directories holding your living documentation. Space-separated.
HARNESS_DOC_DIRS="docs"

# The index every doc must be registered in. Leave empty to disable check-doc-index.
HARNESS_DOC_INDEX="docs/documentation-index.md"

# ── Code ──────────────────────────────────────────────────────────────────────
# Directories holding source you want cited and hygiene-checked. Space-separated.
HARNESS_CODE_DIRS="src"

# File extensions to treat as source, space-separated, no dots.
# Comes from the stack pack. Set it only to narrow or extend what the pack declares.
# HARNESS_CODE_EXTS=""

# ── Decision records ──────────────────────────────────────────────────────────
# Where decision records live, and the filename prefix that identifies one.
# A "decision record" is whatever you call an ADR / RFC / design doc.
HARNESS_DECISION_DIR="docs/decisions"
HARNESS_DECISION_PREFIX="ADR"

# The ledger accounting for each decision's process obligations.
HARNESS_DECISION_LEDGER="docs/registries/decision-process-ledger.md"

# ── Registers ─────────────────────────────────────────────────────────────────
HARNESS_BUG_REGISTER="docs/registers/bug-register.md"

# ── Markers → registries ──────────────────────────────────────────────────────
# The core anti-drift pairing: an inline marker in code MUST have a row in its
# registry. Format: MARKER:path/to/registry.md — space-separated pairs.
#
# Add your own freely. The gate is generic; these are only defaults.
HARNESS_MARKERS="TODO-REGISTERED:docs/registers/todo-registry.md DEFERRED-TEST:docs/registers/deferred-test-registry.md STUB:docs/registers/stub-registry.md"

# ── Secrets in logs ───────────────────────────────────────────────────────────
# Identifiers that must never be passed to a logging call. Space-separated,
# matched case-insensitively as substrings of an argument name.
HARNESS_SECRET_TERMS="password passwd secret token apikey api_key privatekey private_key seed mnemonic otp pin ssn cardnumber"

# Function-name fragments that count as "a logging call". Comes from the stack pack; override
# when your project logs through a wrapper the pack does not know about.
# HARNESS_LOG_FUNCS=""

# ── Tests ─────────────────────────────────────────────────────────────────────
# Commands for the --full tier. The stack pack proposes its ecosystem's conventional ones; CONFIRM
# them against how this project actually builds, because a pack cannot know your layout or flags.
# Empty = skipped, and a skip is reported loudly. It is never a pass.
# HARNESS_TEST_CMD=""
# HARNESS_COVERAGE_CMD=""
# HARNESS_LINT_CMD=""

# ── Language shapes (all from the stack pack — override only what it gets wrong) ──
# HARNESS_DECL_RE=""         # what a function/method declaration line looks like (ERE)
# HARNESS_DECL_STRIP_RE=""   # sed -E expression that leaves just the name
# HARNESS_COMMENT_RE=""      # what a comment line looks like (ERE)
# HARNESS_DOC_BELOW=0        # 1 when docs go BELOW the declaration (Python docstrings)
# HARNESS_TEST_GLOBS=""      # ⚠ anchor basename patterns: */test_* not *test_*
# HARNESS_SKIP_RE=""         # your runner's skip call(s)
# HARNESS_ERROR_RE=""        # tokens meaning "something went wrong" in a condition
# HARNESS_EXCLUDE_GLOBS=""   # vendored, generated, build output
# HARNESS_SCHEMA_GLOBS=""    # schema/migration files (the librarian's ground truth for quantities)
# HARNESS_CONTRACT_GLOBS=""  # API contract files

# Environment variables that, when unset, cause tests to skip. The never-run-tests
# gate uses this to tell "gated but runnable here" from "can never run anywhere".
HARNESS_TEST_ENV_GATES=""

# ── Ratchet baselines ─────────────────────────────────────────────────────────
# Where frozen baselines live. New violations fail; recorded ones are tolerated.
HARNESS_BASELINE_DIR=".harness/baselines"

# The branch a ratcheted gate diffs against to find "what you touched".
HARNESS_BASE_REF="origin/main"

# ── Platform layer (agent-harness hooks: see ci/platform-layer.md) ────────────
# Databases whose data must survive everything (dev DBs with real test users,
# shared local instances). The pre-tool guard denies destructive SQL against these
# names; clones matching "<name>_*" stay allowed (the verification-clone pattern).
HARNESS_PROTECTED_DBS=""

# Paths (globs, space-separated) that are ARCHIVED — history, never to be edited.
HARNESS_ARCHIVED_PATHS=""

# Paths (globs) that are GENERATED — regenerate via their script, never hand-edit.
# Format: glob=regeneration-command, space-separated. The guard names the command
# in its refusal so the agent self-corrects instead of retrying.
HARNESS_GENERATED_PATHS=""

# The main branch other sessions share; force-push to it is denied outright.
# (Defaults to HARNESS_BASE_REF's branch if empty.)

# Corpus dirs for the read-budget advisory (main agent reading docs it should be
# delegating to the librarian) and for librarian-sweep.sh surface groups.
HARNESS_CORPUS_DIRS="docs"

# Bytes of corpus the MAIN session may read directly before the advisory fires
# (60KB default; subagents are exempt — reading is their job).
HARNESS_READ_BUDGET_BYTES="61440"

# Sibling repos (relative to the repo root's PARENT) that belong to this product
# but live outside this repo. librarian-sweep reports them ABSENT when missing —
# never silently skipped.
HARNESS_SIBLING_REPOS=""

# ── Platform-layer additions (2026-09-29, generalised from a live project) ─────────────────────
# Hook instrumentation logs (read-budget, claim-check, stop-advisory, compaction). NEVER point this at a
# directory your gate run clears: the advisories exist to accumulate weeks of hit-rate.
HARNESS_LOG_DIR=".harness-logs"

# Stop-hook claim check (scripts/claim-check.py): advise = a message the human sees + a log line;
# block = the model corrects itself once before finishing. Start with advise; decide after two weeks
# of $HARNESS_LOG_DIR/claim-check.log. Bug ids use this prefix (decision ids use HARNESS_DECISION_PREFIX).
HARNESS_CLAIMCHECK_MODE="advise"
HARNESS_BUG_PREFIX="BUG"

# Bug-register rotation (scripts/rotate-bug-register.sh): archive for long-closed rows.
# Default: <HARNESS_BUG_REGISTER without .md>-archive.md
HARNESS_BUG_ARCHIVE=""

# Onboarding / handover file rotation (scripts/rotate-onboarding.sh). Unset HARNESS_ONBOARDING = N/A.
# The two headings are the PREFIXES of the session-log section and the what-happens-next section.
HARNESS_ONBOARDING=""
HARNESS_ONB_LOG_HEADING="## 8."
HARNESS_ONB_NEXT_HEADING="## 6."
HARNESS_ONB_ARCHIVE=""

# ── Additions from the harness-engineering source study (2026-09-30; ci/platform-layer.md P9) ──────
# End-of-turn verify check (scripts/verify-check.py): a turn that changed code under HARNESS_CODE_DIRS
# and then ran no test/build/gate command. advise | block | off — start with advise, decide after two
# weeks of $HARNESS_LOG_DIR/verify-check.log. HARNESS_TEST_CMD/LINT/COVERAGE are recognised; add any
# other verification command your project uses as an extended regex.
HARNESS_VERIFYCHECK_MODE="advise"
HARNESS_VERIFY_RE=""

# Repeat check (scripts/hook-repeat-check.sh): this many identical tool calls in a row → "stop and
# diagnose" (advisory). Tools that legitimately poll are exempt (space-separated tool names).
HARNESS_REPEAT_LIMIT="3"
HARNESS_REPEAT_EXEMPT="BashOutput TaskOutput TaskGet TaskList ReadNotifications Monitor ScheduleWakeup"

# The guard's control floor (scripts/guard-check.py) always protects .claude/settings*.json,
# scripts/hook-*.sh, the judge scripts and THIS file. Add more paths (repo-relative globs) here; you
# cannot remove the defaults. The override is NOT a setting in this file, on purpose: the owner starts
# a harness-maintenance session with  HARNESS_ALLOW_CONTROL_EDITS=1 claude  and the banner says so.
HARNESS_CONTROL_PATHS=""

# ── Search (scripts/find.sh, v1.3) ───────────────────────────────────────────────────────────────
# The harness's OWN files, listed after the project's in every search so process docs stop crowding
# the answers (repo-relative; a trailing / means a folder). Leave the line OUT for the default below;
# set it empty to list everything together.
# HARNESS_FIND_LAST="docs/ci/ .claude/ evals/ harness.conf harness.conf.example AGENTS.md TAILORING.md CHEAT-SHEET.md CONVENTIONS.md CONTRIBUTING.md"

# ── Second opinion (scripts/second-opinion.sh) — the harness never REQUIRES an outside API ─────────
# Where the harness asks for an independent reviewer (cross-author tests, a second review of a diff,
# an adversarial design debate), THIS decides who that is:
#   external  outside models, tried in order; the first that answers wins, failures fall through.
#   local     a Claude subagent (HARNESS_LOCAL_REVIEWER) with an adversarial brief — same model family,
#             so weaker (shared blind spots), but always available. The default.
#   off       no second opinion: a checklist self-review, stated as such.
HARNESS_SECOND_OPINION="local"
HARNESS_LOCAL_REVIEWER="red-team"      # .claude/agents/red-team.md — or nominate your own agent
# external only — space-separated  name=command  pairs. Each command reads the prompt on stdin and
# prints the answer (a small wrapper script around a provider CLI/API). API keys stay in the
# environment or the gitignored key file (HARNESS_KEY_FILE), read by the WRAPPER — never written here. Example:
#   HARNESS_EXTERNAL_REVIEWERS="modelA=scripts/models/model-a.sh modelB=scripts/models/model-b.sh"
HARNESS_EXTERNAL_REVIEWERS=""
# external only — reviewers asked IN ADDITION to the chain, in parallel, never instead of it. Entry form
# name[@SECONDS]=command [arg ...]: a word like name= starts a new entry, every other word is an argument of
# the entry before it (no quoting; each word reaches the program as written). Each extra runs in its own
# process group and is stopped (TERM, then KILL) after its limit. An extra's answer is printed after the
# chain's, under a header naming it, and never changes the exit code. Needs python3. Example:
#   HARNESS_ALSO_ASK="fast=scripts/models/fast.sh --model small"
HARNESS_ALSO_ASK=""
# Default time limit for an extra reviewer, in seconds (1 to 99999). WHY: a hung outside call must not hold the run.
HARNESS_ALSO_ASK_LIMIT_S="900"
# The file holding the reviewers' keys. Used only to decide the worktree hand-over: a call from a linked
# worktree with no such file goes to the main checkout's own script, so worktree code never handles a key.
# Never read by the harness; a relative path, no "..".
HARNESS_KEY_FILE=".env"

# ── Agent work: token discipline, the review step, resilience, the run log (v1.7) ─────────────────
# Every knob below has a default; leave a line out to take it. WHY each exists: ci/token-budget.md,
# ci/review-step.md, ci/session-resilience.md.

# At most this many sessions or builder agents doing work at once (token discipline R5). Read by the
# lead and the briefs, not by a script: past about 4 the extra agents only queued for the test lock
# and polled while they waited.
HARNESS_MAX_SESSIONS="4"

# Where the agent logs live: runs.jsonl (scripts/log-agent-run.py), reviews.jsonl (check-the-work.sh
# judge) and criterion.jsonl (the success-criterion hook). Committed with the work.
HARNESS_AGENT_DIR="docs/agents"

# The security-hardening register: a review finding tagged pre-existing may be routed to it (SEC-nnn).
HARNESS_SEC_REGISTER="docs/tickets/security.md"

# Vote mode of the review step: several outside reviewers must agree on a finding. OFF by default,
# because every round then makes paid outside calls — the owner turns it on.
HARNESS_REVIEW_VOTE="off"
# The voters: "name=command ..." (a command reads the prompt on stdin and prints a reviewer answer).
HARNESS_REVIEW_VOTERS=""
# The pre-send secret scan for vote mode: a command reading the prompt on stdin (exit 0 clean, 5
# refused). Empty while the vote is on = nothing is sent (check-the-work.sh exits 6).
HARNESS_REVIEW_SCAN=""
# check-the-work.sh also reads CHECK_THE_WORK_MAX_ROUNDS (default 3) and CHECK_THE_WORK_BASE (default:
# HARNESS_BASE_REF, then its local branch) from the environment.

# Where the lead finds a branch's FINAL report at the merge (the report-contract hook). Empty = the
# hook says NOT CHECKED (exit 4) unless CTW_REPORT names the file. Never a silent pass.
HARNESS_REPORT_DIR=""
# Extra shell patterns for files that JUDGE code (beyond the tests, gates, baselines and registries
# the success-criterion hook already knows), e.g. golden files or a coverage floor file.
HARNESS_JUDGE_GLOBS=""

# Reference index (scripts/refs.sh): the id families besides HARNESS_DECISION_PREFIX and
# HARNESS_BUG_PREFIX. A token PREFIX-NN counts as an id only when its prefix is listed here.
HARNESS_REFS_IDS="USER DEC FEAT DOC BIZ SEC TBD"

# Run log (scripts/log-agent-run.py). Allowed model names, each optionally name:family; EMPTY = any
# name is accepted (lower-cased). WHY a list at all: names drift ("mid" vs "mid-5") and then cannot be
# summed per model. Aliases map a variant to the canonical name: "alias=name ...".
HARNESS_RUNLOG_MODELS=""
HARNESS_RUNLOG_MODEL_ALIASES=""
# Roles the run log accepts (a typo cannot start a new role); default: builder tester test-author
# reviewer hunter lead sub-session analyst researcher writer scribe architect librarian designer ui-builder
# HARNESS_RUNLOG_ROLES=""
# The wave field (the runner row id), as a regex, or "none".
# HARNESS_RUNLOG_WAVE_RE="[A-Z]{1,2}[0-9]{1,4}[a-z]?"

# Heavy-run queue (scripts/heavy-run.sh): how many heavy runs (full suites, mutation batches) may run
# at once on this machine, 1-8. WHY: one heavy run already uses several cores, and a plain lock served
# waiters in random order (one session waited two hours). Default 1.
# HARNESS_HEAVY_SLOTS="1"
# The queue folder. WHY: every worktree of one repository must share one queue, and nothing may land in
# the tree. Default: <the repository's common git dir>/harness-heavy.
# HARNESS_HEAVY_LOCK_DIR=""
# The wait-time log. WHY: a wait nobody can see reads as a hung session. Default: <queue folder>/wait-log.tsv
# HARNESS_HEAVY_LOG=""
# Most resumes of a dead sub-session before resume-brief.sh prints a STOP summary of the best partial
# result instead of a brief (0-9). WHY: a third retry of the same work buys luck, not progress. Default 2.
# HARNESS_RESUME_CAP="2"
