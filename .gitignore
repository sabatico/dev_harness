.DS_Store
*.local
.claude/settings.local.json   # per-machine permission grants — never shared

# Hook advisory logs (hook-stop-statecheck, hook-read-budget, hook-precompact-log).
# Untracked-and-unignored would put these in every `git status` AND invalidate the push
# receipt's working-tree hash (gates.md G4 deliberately hashes untracked files), which is
# the shared-checkout collision class the orchestrating-agents skill documents.
.gate-logs/
# Hook instrumentation logs (read-budget, claim-check, stop-advisory, compaction): HARNESS_LOG_DIR.
# Kept apart from any per-run gate-output dir on purpose — a project whose gate run clears its log dir
# destroyed five weeks of advisory hit-rate data that way (the source project, 2026-09-29).
.harness-logs/

# The push receipt: a hash of the verified tree. Per-machine, per-moment — never shared.
.gate-receipt

# init.sh writes these per-project; the KIT's own copies are committed deliberately
# (harness.conf makes the kit self-hosting; the baseline records its installed-layout paths).

# The maintainer's personal-data check and its test stay LOCAL ONLY (owner ruling): the test's fake
# examples read like real personal data, and the check pairs with a local list of the maintainer's terms.
scripts/check-no-pii.sh
scripts/check-no-pii-test.sh
